# ============================================================
# PUSATPERIZINAN.COM — Contoh Environment Variables
# Salin jadi ".env.production" di folder Application root
# (Hostinger File Manager), sesuaikan nilainya.
# ============================================================

# ── WAJIB ───────────────────────────────────────────────────
# Database SQLite — gunakan PATH ABSOLUT folder aplikasi Anda.
# Lihat path asli di hPanel File Manager (mis. /home/u123456789/...)
DATABASE_URL=file:/home/USERNAME_HOSTINGER/domains/pusatperizinan.com/nodeapp/db/custom.db

# Password login admin Mission Control (https://domain/admin)
ADMIN_PASSWORD=GANTI_PASSWORD_KUAT_ANDA

# Kunci HMAC cookie sesi admin — string acak 32+ karakter
# (generator: https://www.random.org/strings/ atau `openssl rand -hex 32`)
ADMIN_SECRET=GANTI_STRING_ACAK_PANJANG

# ── OPSIONAL — notifikasi lead real-time (bisa diatur dari /admin juga) ──
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=123456789
# FONNTE_TOKEN=token-dari-fonnte.com
# WHATSAPP_TARGET=6281269999910

# ── PEMBAYARAN OTOMATIS (checkout /checkout) ─────────────────
# Prioritas otomatis: Midtrans → Tripay → Uji Coba → Transfer manual.
# Isi SATU gateway saja (Midtrans ATAU Tripay), lalu set Uji Coba=false.

# 1) Mode uji coba: true = pembayaran disimulasikan (TIDAK ada uang nyata).
#    WAJIB dihapus/di-false setelah gateway produksi aktif!
PAYMENT_DEMO_MODE=true

# 2) MIDTRANS (Snap) — daftar di https://midtrans.com ( produk Goto/GoPay )
# MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxx
# MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxx
# MIDTRANS_IS_PRODUCTION=false   ← ganti "true" saat kunci produksi
# Webhook (Payment Notification URL) di dashboard Midtrans:
#   https://pusatperizinan.com/api/payment/webhook/midtrans

# 3) TRIPAY — paling mudah untuk usaha perorangan: https://tripay.co.id
# TRIPAY_API_KEY=xxxx
# TRIPAY_PRIVATE_KEY=xxxx
# TRIPAY_MERCHANT_CODE=T12345
# TRIPAY_IS_PRODUCTION=false
# TRIPAY_METHODS=QRIS,BRIVA,BCAVA,BNIVA,MANDIRIVA,SHOPEEPAY,ALFAMART,INDOMARET
# URL Callback di dashboard Tripay:
#   https://pusatperizinan.com/api/payment/webhook/tripay

# 4) Fallback transfer manual (tampil bila tidak ada gateway)
# BANK_TRANSFER_INFO=BCA 1234567890 a.n. PT Digital Bisnis Manajemen
#   BRI 0987654321 a.n. PT Digital Bisnis Manajemen
