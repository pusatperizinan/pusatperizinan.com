# ============================================================
# PUSATPERIZINAN.COM — Contoh Environment Variables
# Salin jadi ".env.production" di folder Application root
# (Hostinger File Manager), sesuaikan nilainya.
# ============================================================

# ── WAJIB ───────────────────────────────────────────────────
# Database SQLite — gunakan PATH ABSOLUT folder aplikasi Anda.
# Lihat path asli di hPanel File Manager (mis. /home/u123456789/...)
DATABASE_URL=file:/home/USERNAME_HOSTINGER/domains/pusatperizinan.com/nodeapp/db/custom.db

# Password login admin Mission Control (https://domain/admin)
ADMIN_PASSWORD=GANTI_PASSWORD_KUAT_ANDA

# Kunci HMAC cookie sesi admin — string acak 32+ karakter
# (generator: https://www.random.org/strings/ atau `openssl rand -hex 32`)
ADMIN_SECRET=GANTI_STRING_ACAK_PANJANG

# ── OPSIONAL — notifikasi lead real-time (bisa diatur dari /admin juga) ──
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=123456789
# FONNTE_TOKEN=token-dari-fonnte.com
# WHATSAPP_TARGET=6281269999910
